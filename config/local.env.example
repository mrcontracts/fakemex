# Copy this file to local.env, chmod 0600, and keep it private.
# FakeMex always starts on testnet. The Enable Mainnet toggle requires a complete
# mainnet account/API-wallet profile; TRADING_ENABLED independently gates writes.
HL_TESTNET_API_URL=https://api.hyperliquid-testnet.xyz
HL_TESTNET_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
HL_TESTNET_ACCOUNT_ADDRESS=
HL_TESTNET_API_WALLET_ADDRESS=
HL_TESTNET_API_WALLET_PRIVATE_KEY=

HL_MAINNET_API_URL=https://api.hyperliquid.xyz
HL_MAINNET_WS_URL=wss://api.hyperliquid.xyz/ws
HL_MAINNET_ACCOUNT_ADDRESS=
HL_MAINNET_API_WALLET_ADDRESS=
HL_MAINNET_API_WALLET_PRIVATE_KEY=

SERVER_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:4200
LOG_LEVEL=info
# Process-level permission for signed writes on either configured network.
# The separate toolbar Trading toggle still starts OFF and every network switch turns it OFF.
TRADING_ENABLED=false
